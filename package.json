{
  "name": "aqib-faraz-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://aqibfaraz.dev",
  "dependencies": {
    "gh-pages": "^6.1.1",
    "gray-matter": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
